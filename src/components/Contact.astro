---
const offices = [
  {
    city: "San Francisco",
    address: ["100 Embarcadero", "Suite 1200", "San Francisco, CA 94111"],
    phone: "+1 (415) 555-0100",
    tone: "linear-gradient(135deg, #d9d4c7, #b6b1a1)",
  },
  {
    city: "Boston",
    address: ["55 Atlantic Ave", "Floor 4", "Boston, MA 02110"],
    phone: "+1 (617) 555-0100",
    tone: "linear-gradient(135deg, #c7cdd3, #9aa2ab)",
  },
];
---

<section id="contact" class="py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="mb-14">
      <p class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-muted)] mb-3">Contact</p>
      <h2 class="text-3xl md:text-5xl font-medium tracking-tight">Two coasts, one team.</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-10">
      {offices.map((o) => (
        <div>
          <div class="aspect-[4/3] w-full rounded-sm" style={`background: ${o.tone}`}></div>
          <div class="mt-6">
            <div class="text-2xl font-medium tracking-tight">{o.city}</div>
            <div class="mt-3 text-sm text-[color:var(--color-muted)] leading-relaxed">
              {o.address.map((line) => <div>{line}</div>)}
            </div>
            <a
              href={`tel:${o.phone.replace(/[^+\d]/g, "")}`}
              class="mt-3 inline-block text-sm hover:underline"
            >
              {o.phone}
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 border-t border-[color:var(--color-line)] pt-10 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="text-sm uppercase tracking-[0.2em] text-[color:var(--color-muted)]">General inquiries</div>
        <a href="mailto:hello@example.com" class="text-2xl md:text-3xl font-medium tracking-tight hover:underline">
          hello@example.com
        </a>
      </div>
      <form class="flex items-center gap-2 w-full md:w-auto">
        <input
          type="email"
          placeholder="Subscribe to our newsletter"
          class="flex-1 md:w-80 px-4 py-2.5 rounded-full border border-[color:var(--color-line)] text-sm focus:outline-none focus:border-[color:var(--color-ink)]"
        />
        <button
          type="submit"
          class="px-5 py-2.5 rounded-full bg-[color:var(--color-ink)] text-white text-sm hover:opacity-90"
        >
          Subscribe
        </button>
      </form>
    </div>
  </div>
</section>
