---
const links = [
  { href: "#about", label: "About" },
  { href: "#team", label: "Team" },
  { href: "#portfolio", label: "Portfolio" },
  { href: "#contact", label: "Contact" },
];
---

<header
  class="sticky top-0 z-50 backdrop-blur bg-white/80 border-b border-[color:var(--color-line)]"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-10 h-16 flex items-center justify-between">
    <a href="#top" class="wordmark text-xl tracking-tight">Lattice</a>
    <nav class="hidden md:flex items-center gap-8 text-sm">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-[color:var(--color-ink)]/80 hover:text-[color:var(--color-ink)] transition-colors"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <button
      id="menu-toggle"
      class="md:hidden inline-flex items-center justify-center w-9 h-9 rounded border border-[color:var(--color-line)]"
      aria-label="Toggle menu"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden md:hidden border-t border-[color:var(--color-line)]">
    <div class="px-6 py-4 flex flex-col gap-3 text-sm">
      {links.map((l) => <a href={l.href} class="py-1">{l.label}</a>)}
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>
